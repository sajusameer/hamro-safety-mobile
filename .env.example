# Hamro Safety - Environment Variables Template
# Company: Zuptrix Solutions Pvt. Ltd.
# Tagline: "Your Safety. Our Priority."

# ==============================================================================
# INSTRUCTIONS FOR CLIENT / DEVELOPER:
# 1. Copy this file to '.env' in the root directory: `cp .env.example .env`
# 2. Open your Supabase Dashboard -> Project Settings -> API
# 3. Paste your Project URL and Anon API Key below.
# 4. Save the '.env' file and restart the Expo app server (`npx expo start -c`).
# Note: If placeholders are unchanged, the application falls back gracefully to
# offline demo mode with mock data for instant preview & UI verification.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Supabase Public Anon Key (JWT key starting with eyJ...)
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# App Environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development
